#   ILD_DB_data.tar.gz               <- ILD_DB_talismanTestSuite/ + ILD_DB_volumeROIs/
#   wholect_lung_ddpm_dataset.tar.gz <- wholect/lung_ddpm_model/ILD_dataset/
#   processed_npy_datasets.tar.gz    <- ALL .npy under patches/ and wholect/
#                                        (overlaps with ILD_dataset/ on purpose --
#                                        self-contained, not meant to dedupe)
#   checkpoints.tar.gz               <- all *.pth (nnU-Net + Lung-DDPM 2D/3D)
#   nnunet_raw_images.tar.gz         <- wholect/lung_ddpm_model/nnUNet_raw/Dataset502_ILD/
#   generated_and_previews.tar.gz    <- Lung-DDPM/generated/ + Lung-DDPM/checkpoints/*/previews/
#   attention_checkpoints.tar.gz     <- diffusion_model/outputs_attention/
